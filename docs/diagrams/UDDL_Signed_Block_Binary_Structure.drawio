          <mxGeometry x="37" y="996" width="561" height="27" as="geometry" />
        </mxCell>
        <mxCell id="t118" value="• Reject new unauthorized/unresolved blocks before any write." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13.4;fontStyle=0;fontColor=#1D314D;overflow=hidden;" vertex="1" parent="1">
