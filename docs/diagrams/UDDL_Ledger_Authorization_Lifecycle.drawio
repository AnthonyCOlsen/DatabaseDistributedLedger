<mxfile host="Electron" agent="UDDL Architecture" version="24.7.17" type="device"><diagram id="uddl-ledger-authorization-lifecycle" name="Ledger Authorization Lifecycle"><mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#172A4B;fillColor=#172A4B;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="24" y="18" width="1692" height="92" as="geometry" /></mxCell><mxCell id="title" value="UDDL  ·  Ledger Authorization Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=36;fontColor=#ffffff;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="1580" height="44" as="geometry" /></mxCell><mxCell id="sub" value="Genesis trust → master grants → two-signature revocation → historical authorization and reclassification" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#E7EFFB;fontStyle=0;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="80" y="79" width="1580" height="24" as="geometry" /></mxCell><mxCell id="step1" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#2865AE;fillColor=#EFF5FD;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="36" y="128" width="394" height="50" as="geometry" /></mxCell><mxCell id="step1_t" value="STEP 1  ·  SIGNED LEDGER — ACCEPTED" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#2865AE;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="142" width="386" height="27" as="geometry" /></mxCell><mxCell id="step2" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#BA403C;fillColor=#FFF1EF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="443" y="128" width="395" height="50" as="geometry" /></mxCell><mxCell id="step2_t" value="STEP 2  ·  SQL INTERCEPTION — PLANNED" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#BA403C;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="447" y="142" width="387" height="27" as="geometry" /></mxCell><mxCell id="step3" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#277C50;fillColor=#EDF7F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="851" y="128" width="395" height="50" as="geometry" /></mxCell><mxCell id="step3_t" value="STEP 3  ·  PROJECTION / REPLAY — PLANNED" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#277C50;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="855" y="142" width="387" height="27" as="geometry" /></mxCell><mxCell id="step4" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#117B91;fillColor=#ECF8FA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1261" y="128" width="443" height="50" as="geometry" /></mxCell><mxCell id="step4_t" value="STEP 4  ·  PEER SYNC — PLANNED" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#117B91;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1265" y="142" width="435" height="27" as="geometry" /></mxCell><mxCell id="left_panel" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#B1CEEA;fillColor=#F2F7FD;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="27" y="207" width="527" height="548" as="geometry" /></mxCell><mxCell id="mid_panel" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#CDB9E7;fillColor=#FCF7FC;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="574" y="207" width="543" height="548" as="geometry" /></mxCell><mxCell id="right_panel" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#A9D4D8;fillColor=#F2F9F9;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="1137" y="207" width="576" height="548" as="geometry" /></mxCell><mxCell id="left_h" value="1  ·  GENESIS &amp;amp; GRANTS" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#2865AE;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="480" height="32" as="geometry" /></mxCell><mxCell id="mid_h" value="2  ·  TWO-SIGNATURE REVOCATION" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#734AAF;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="594" y="220" width="500" height="32" as="geometry" /></mxCell><mxCell id="right_h" value="3  ·  ADMISSION OF NEW BLOCKS" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#117B91;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1157" y="220" width="536" height="32" as="geometry" /></mxCell><mxCell id="genesis" value="&lt;div style=&quot;font-size:19px;color:#2865AE;font-weight:bold;margin-bottom:8px&quot;&gt;GENESIS  ·  unique trust anchor&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;Self-signed by original Master A&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;Ledger ID = A’s 32-byte public key&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;All members pin full signed-genesis SHA-512&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#AAC8EA;fillColor=#EFF5FD;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="56" y="270" width="468" height="119" as="geometry" /></mxCell><mxCell id="master_a" value="&lt;div style=&quot;font-size:21px;color:#277C50;font-weight:bold;margin-bottom:8px&quot;&gt;Master A&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;Initially authorized&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;by valid genesis&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#9DCDAF;fillColor=#EDF7F0;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="57" y="452" width="202" height="99" as="geometry" /></mxCell><mxCell id="grant" value="&lt;div style=&quot;font-size:20px;color:#734AAF;font-weight:bold;margin-bottom:8px&quot;&gt;GRANT_MASTER&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Authorized master signs&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;grant naming Master B&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Effective at its canonical position&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#CBB4E4;fillColor=#F5F0FA;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="286" y="445" width="234" height="112" as="geometry" /></mxCell><mxCell id="master_b" value="&lt;div style=&quot;font-size:20px;color:#277C50;font-weight:bold;margin-bottom:8px&quot;&gt;Master B&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;Authorized from the&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;grant’s canonical position&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#9DCDAF;fillColor=#EDF7F0;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="286" y="606" width="234" height="90" as="geometry" /></mxCell><mxCell id="left_note" value="Ledger ID never changes—even if Master A is revoked." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#53647A;fontStyle=0;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="51" y="710" width="475" height="27" as="geometry" /></mxCell><mxCell id="acon" value="&lt;div style=&quot;font-size:19px;color:#734AAF;font-weight:bold;margin-bottom:8px&quot;&gt;A creates signed consent&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;A’s current UTC tA; intended block GUID&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;Ledger ID, both keys, revoked target A or B&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;Consent bears A’s Ed25519 signature&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#CBB4E4;fillColor=#F5F0FA;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="599" y="270" width="492" height="128" as="geometry" /></mxCell><mxCell id="bblock" value="&lt;div style=&quot;font-size:18px;color:#734AAF;font-weight:bold;margin-bottom:8px&quot;&gt;B creates the final REVOKE_MASTER block&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;B verifies A’s consent and both authorities&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;B chooses B’s own current UTC tB&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;B signs entire block, including A’s consent&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#CBB4E4;fillColor=#F5F0FA;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="599" y="448" width="492" height="143" as="geometry" /></mxCell><mxCell id="revoke_out" value="&lt;div style=&quot;font-size:19px;color:#BA403C;font-weight:bold;margin-bottom:8px&quot;&gt;Revocation takes effect&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Target loses master authority at final canonical position&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;A later GRANT can reauthorize, never retroactively&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#E0B0AA;fillColor=#FFF1EF;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="599" y="640" width="492" height="84" as="geometry" /></mxCell><mxCell id="window" value="REQUIRED: 0 ≤ (tB − tA) ≤ 900,000 ms" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#734AAF;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="663" y="602" width="420" height="25" as="geometry" /></mxCell><mxCell id="candidate" value="&lt;div style=&quot;font-size:20px;color:#117B91;font-weight:bold;margin-bottom:8px&quot;&gt;New signed block&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;Locally authored: software uses current UTC&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-bottom:3px&quot;&gt;Received late: retain its original signed time&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#9CCDD8;fillColor=#ECF8FA;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1162" y="270" width="525" height="96" as="geometry" /></mxCell><mxCell id="check" value="&lt;div style=&quot;font-size:19px;color:#2865AE;font-weight:bold;margin-bottom:8px&quot;&gt;Validate in bounded memory&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Protocol, hash, Ed25519 signature, ledger/genesis&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Historical master authorization at canonical position&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;No new-block filesystem write before validation&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#AAC8EA;fillColor=#EFF5FD;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1162" y="410" width="525" height="107" as="geometry" /></mxCell><mxCell id="save" value="&lt;div style=&quot;font-size:18px;color:#277C50;font-weight:bold;margin-bottom:8px&quot;&gt;AUTHORIZED → .BLK&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Durably retain exact&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;original signed bytes&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#9DCDAF;fillColor=#EDF7F0;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1165" y="634" width="248" height="91" as="geometry" /></mxCell><mxCell id="reject" value="&lt;div style=&quot;font-size:18px;color:#BA403C;font-weight:bold;margin-bottom:8px&quot;&gt;NOT PROVEN → REJECT&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Unresolved or false authority:&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;no .BLK or .XBLK saved&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#E0B0AA;fillColor=#FFF1EF;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440" y="634" width="247" height="91" as="geometry" /></mxCell><mxCell id="history_panel" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#B8C9DE;fillColor=#F5F8FC;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="27" y="781" width="1686" height="286" as="geometry" /></mxCell><mxCell id="history_h" value="4  ·  LATE-ARRIVING HISTORY &amp;amp; CANONICAL RECLASSIFICATION" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#172A4B;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="50" y="795" width="1633" height="32" as="geometry" /></mxCell><mxCell id="late" value="&lt;div style=&quot;font-size:18px;color:#117B91;font-weight:bold;margin-bottom:8px&quot;&gt;Earlier valid GRANT / REVOKE arrives&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;A new history block may have an earlier&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;signed UTC time than already retained blocks&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#9CCDD8;fillColor=#ECF8FA;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="51" y="858" width="386" height="109" as="geometry" /></mxCell><mxCell id="sort" value="&lt;div style=&quot;font-size:17px;color:#2865AE;font-weight:bold;margin-bottom:8px&quot;&gt;Replay authority in canonical order&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;(timestamp_utc_ms, block_guid, signer_public_key)&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Recalculate authority at every signed position&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#AAC8EA;fillColor=#EFF5FD;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="488" y="858" width="418" height="109" as="geometry" /></mxCell><mxCell id="classify" value="&lt;div style=&quot;font-size:19px;color:#734AAF;font-weight:bold;margin-bottom:8px&quot;&gt;Reclassify only previously accepted history&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Old .BLK can move to local .XBLK if later found unauthorized&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;An archived .XBLK can return to .BLK if history supports it&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-bottom:3px&quot;&gt;Never re-sign, overwrite, or propagate archived .XBLK files&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#CBB4E4;fillColor=#F5F0FA;strokeWidth=1.25;fontFamily=Arial;fontColor=#223047;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="957" y="858" width="718" height="109" as="geometry" /></mxCell><mxCell id="rule_bg" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeColor=#CCD9E9;fillColor=#EAF1FC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="55" y="988" width="1626" height="57" as="geometry" /></mxCell><mxCell id="rule1" value="STEP 1: block and authority rules accepted (2026-11-18)     ·     STEP 3: projected SQLite replay planned     ·     STEP 4: peer sync / recovery planned" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#172A4B;fontStyle=1;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="75" y="997" width="1583" height="21" as="geometry" /></mxCell><mxCell id="rule2" value="New unauthorized/unresolved input is rejected in memory; only previously retained history may be locally archived as .XBLK." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#53647A;fontStyle=0;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="75" y="1021" width="1583" height="17" as="geometry" /></mxCell><mxCell id="footer" value="Diagram is explanatory; signed wire grammar and CLI behavior remain defined in the authoritative Technical Design and Management API." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#53647A;fontStyle=0;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="100" y="1081" width="1540" height="19" as="geometry" /></mxCell><mxCell id="gtoa" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#277C50;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="161" y="389" as="sourcePoint" /><mxPoint x="161" y="452" as="targetPoint" /></mxGeometry></mxCell><mxCell id="atogrant" value="signs" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BA403C;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="259" y="504" as="sourcePoint" /><mxPoint x="286" y="504" as="targetPoint" /></mxGeometry></mxCell><mxCell id="granttob" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#277C50;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="403" y="557" as="sourcePoint" /><mxPoint x="403" y="606" as="targetPoint" /></mxGeometry></mxCell><mxCell id="a_to_b" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#734AAF;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845" y="398" as="sourcePoint" /><mxPoint x="845" y="448" as="targetPoint" /></mxGeometry></mxCell><mxCell id="b_to_revoke" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BA403C;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="591" as="sourcePoint" /><mxPoint x="634" y="640" as="targetPoint" /></mxGeometry></mxCell><mxCell id="receive_to_check" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#117B91;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1424" y="366" as="sourcePoint" /><mxPoint x="1424" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="check_yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#277C50;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1424" y="517" as="sourcePoint" /><mxPoint x="1289" y="634" as="targetPoint" /><Array as="points"><mxPoint x="1424" y="574" /><mxPoint x="1289" y="574" /></Array></mxGeometry></mxCell><mxCell id="check_no" value="no" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BA403C;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1424" y="517" as="sourcePoint" /><mxPoint x="1563" y="634" as="targetPoint" /><Array as="points"><mxPoint x="1424" y="574" /><mxPoint x="1563" y="574" /></Array></mxGeometry></mxCell><mxCell id="hist1" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2865AE;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="437" y="915" as="sourcePoint" /><mxPoint x="488" y="915" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hist2" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2865AE;strokeWidth=4;endArrow=block;endFill=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="906" y="915" as="sourcePoint" /><mxPoint x="957" y="915" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>